# PostgreSQL connection string.
# The local dev cluster (npm run pg:up) uses this default:
DATABASE_URL=postgres://postgres:postgres@localhost:5432/synergy

# --- Bungie API key ---
# A free Bungie.net application API key. Get one at:
#   https://www.bungie.net/en/Application  (create an app; copy the API Key)
#
# Needed ONLY to run icon ingestion (npm run ingest:icons), which fetches real
# item icons from the Manifest. The app itself renders fine without it (emoji
# fallback). Displaying the icons afterward needs no key — they are public
# bungie.net CDN URLs.
# BUNGIE_API_KEY=
