# PostgreSQL connection string.
# The local dev cluster (npm run pg:up) uses this default:
DATABASE_URL=postgres://postgres:postgres@localhost:5432/synergy

# --- Phase 1 ingestion (not required for the vertical slice) ---
# A registered Bungie.net application API key. Required only when the live
# Manifest ingestion pipeline is enabled. The vertical slice runs entirely
# from the curated seed data and needs no Bungie credentials.
# BUNGIE_API_KEY=
