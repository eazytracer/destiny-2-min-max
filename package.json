{
  "name": "destiny-2-build-synergy-explorer",
  "version": "0.1.0",
  "private": true,
  "description": "A searchable map of Destiny 2 weapons, abilities, artifacts, armor bonuses, and sandbox mechanics — explaining how they interact.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:seed": "tsx src/db/seed.ts",
    "ingest:manifest": "tsx src/ingest/run.ts",
    "pg:up": "bash scripts/pg-dev.sh up",
    "pg:down": "bash scripts/pg-dev.sh down"
  },
  "dependencies": {
    "drizzle-orm": "^0.36.4",
    "next": "15.1.6",
    "postgres": "^3.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "drizzle-kit": "^0.28.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  }
}
